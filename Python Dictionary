#Dict declare
dict = {"model":"ford",
    "speed":120,
    "year":1800}
print(dict)
#Access dict
dict = {"model":"ford",
    "speed":120,
    "year":1800}
print("model")
print(dict.keys())
print(dict.values())
x = dict["color"] = "blue"
print(dict)
#change items
dict = {"model":"ford",
    "speed":120,
    "year":1800}
x = dict["year"]=1803
print(dict)
#remove item
dict = {"model":"ford",
    "speed":120,
    "year":1800}
x = dict.pop("model")
print(dict)
#loop in dict
dict = {"model =":"ford",
    "speed =":120,
    "year =":1800}
for x in dict:
    print(x)
for x in dict:
    print(dict[x])
for x,y in dict.items():
    print(x,y)
#copy dict
dict = {"model":"ford",
    "speed":120,
    "year":1800}
mydict=dict.copy()
print(mydict)
